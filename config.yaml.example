# Kindle Monitor Configuration Template
# Copy this file to config.yaml and fill in your actual values
# config.yaml は .gitignore 済み（秘密情報を含むためコミットしないこと）

kindle:
  # Kindle の IP アドレス（kindle_display_enhanced.py はこの IP へ直接接続）
  ip_address: "192.168.0.100"
  mac_address: "xx:xx:xx:xx:xx:xx"
  network_range: "192.168.0.0/24"

  ssh:
    username: "root"
    # 鍵認証を使う場合にパスを指定（推奨）
    private_key_path: null  # 例: "/home/<user>/.ssh/kindle_id_rsa"
    # パスワード認証（鍵認証が使えない場合）
    password: null
    port: 22
    timeout: 5

  sftp_target: "/mnt/us/panel.png"
  display_command: "/usr/sbin/eips -d l=0,w=780,h=40 & /usr/sbin/eips -f -y 40 -g /mnt/us/panel.png"
  screensaver_command: "cp /mnt/us/panel.png /usr/share/blanket/screensaver/bg_medium_ss00.png"

sensors:
  data_source: "wio_link_weather"

  # Wio Link センサー設定（Environment カードの Temp/Humi）
  wio_link:
    base_url: "https://wiolink.seeed.co.jp/v1/node"
    sensor:
      name: "リビング"
      node_id: "GroveTempHumD0"
      access_token: "YOUR_WIO_LINK_ACCESS_TOKEN"
      temp_key: "celsius_degree"
      humi_key: "humidity"

  # 天気 API 設定（tsukumijima.net, 気象庁地域コード）
  weather:
    api_url: "https://weather.tsukumijima.net/api/forecast"
    city_code: "270000"  # 270000 = 大阪

display:
  panel:
    width: 758
    height: 1024

  margin:
    panel: [30, 30]

  temp_image: "/tmp/panel.png"
  calendar_image: "/tmp/image_600x800.png"

fonts:
  path: "/usr/share/fonts/opentype/noto"
  font_map:
    # Noto CJK フォント（日本語対応: sudo apt install fonts-noto-cjk）
    SHINGO_REGULAR: "NotoSansCJK-Regular.ttc"
    SHINGO_MEDIUM: "NotoSansCJK-Medium.ttc"
    SHINGO_BOLD: "NotoSansCJK-Bold.ttc"
    # DejaVu フォント（英数字）
    FUTURA_COND_BOLD: "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf"
    FUTURA_COND: "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf"
    FUTURA_MEDIUM: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
    FUTURA_BOLD: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"

# Claude カード / Claude Code Sessions カードの表示（任意）
# 認証は ~/.claude/.credentials.json の OAuth トークンを使用（リフレッシュはしない）。
# 取得できない場合もキャッシュ値とローカルログ集計で表示を継続します。
anthropic:
  enabled: false

logging:
  enabled: true
  level: "INFO"
  file: null
