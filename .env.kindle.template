# Kindle Monitor Environment Configuration
# Copy this file to ~/.env.kindle and fill in your values
# chmod 600 ~/.env.kindle  (to restrict permissions)
# run_kindle_display.sh が存在すれば自動で読み込みます

# Optional: Anthropic API key (Claude usage 取得のフォールバック)
# 通常は ~/.claude/.credentials.json の OAuth トークンが優先して使われます。
# config.yaml の anthropic.enabled: true のときのみ参照されます。
# export ANTHROPIC_API_KEY="sk-ant-your-actual-key-here"

# Optional: Log file path (default: <project>/logs/kindle_monitor.log)
# export LOG_FILE="$HOME/logs/kindle_monitor.log"
