# Kindle Monitor Environment Configuration
# Copy this file to ~/.env.kindle and fill in your actual API key
# chmod 600 ~/.env.kindle  (to restrict permissions)

# Anthropic API Key (required for Claude usage display)
export ANTHROPIC_API_KEY="sk-ant-your-actual-key-here"

# Optional: Log file path (default: /var/log/kindle_monitor.log)
# export LOG_FILE="$HOME/logs/kindle_monitor.log"
